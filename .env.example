# Replace with a random URL-safe password before starting; never commit .env.
POSTGRES_PASSWORD=replace-with-a-random-url-safe-password
LOG_LEVEL=info
# For npm commands outside Compose, set DATABASE_URL to a reachable PostgreSQL 17 database.
# DATABASE_URL=postgres://orderflow:URL_ENCODED_PASSWORD@127.0.0.1:5432/orderflow
