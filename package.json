{
  "name": "orderflow",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js",
    "migrate": "node dist/migrate.js",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:integration": "npm run build && node --test test/integration.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test:compose": "node test/compose.mjs"
  },
  "dependencies": {
    "fastify": "^5.6.2",
    "pg": "^8.16.3",
    "pino": "^10.1.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/pg": "^8.15.6",
    "typescript": "^5.9.3"
  }
}
